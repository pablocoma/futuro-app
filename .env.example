# Copia esto a .env y rellena lo que haga falta. `.env` está en .gitignore:
# ningún secreto entra en este repositorio.

# ---------------------------------------------------------------------------
# Desarrollo local: con estos valores `make up` levanta la app entera sin
# necesitar cuenta de Google ni dominio.
# ---------------------------------------------------------------------------
ENV=development
LOG_LEVEL=DEBUG
APP_DOMAIN=:8080
PUBLIC_BASE_URL=http://localhost:8080

# Inyecta un usuario fijo y salta OAuth. Solo se honra con ENV=development;
# con ENV=production la API lo ignora.
DEV_AUTH_BYPASS=true
DEV_AUTH_EMAIL=dev@localhost

POSTGRES_DB=futuro
POSTGRES_USER=futuro
POSTGRES_PASSWORD=futuro

# ---------------------------------------------------------------------------
# Producción. Con ENV=production la API no arranca si falta cualquiera de
# estos, en vez de fallar más tarde en la primera petición que lo necesite.
# ---------------------------------------------------------------------------
# ENV=production
# APP_DOMAIN=futuro.example.com
# PUBLIC_BASE_URL=https://futuro.example.com
# DEV_AUTH_BYPASS=false

# `openssl rand -hex 32`. Cambiarlo invalida todas las sesiones abiertas.
# SESSION_SECRET=

# Credenciales del cliente OAuth de Google. Redirect URI autorizado:
# https://<APP_DOMAIN>/api/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Allowlist de acceso, separada por comas. En la práctica, un solo email.
# ALLOWED_EMAILS=
