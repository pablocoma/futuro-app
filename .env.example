# Copia esto a .env y rellena lo que haga falta. `.env` está en .gitignore:
# ningún secreto entra en este repositorio.

# ---------------------------------------------------------------------------
# Desarrollo local: con estos valores `make up` levanta la app entera sin
# necesitar cuenta de Google ni dominio.
# ---------------------------------------------------------------------------
ENV=development
LOG_LEVEL=DEBUG
APP_DOMAIN=:8080
PUBLIC_BASE_URL=http://localhost:8080

# Inyecta un usuario fijo y salta OAuth. Solo se honra con ENV=development;
# con ENV=production la API lo ignora.
DEV_AUTH_BYPASS=true
DEV_AUTH_EMAIL=dev@localhost

POSTGRES_DB=futuro
POSTGRES_USER=futuro
POSTGRES_PASSWORD=futuro

# Con `stub`, las extracciones no llaman a ningún modelo: se simulan a
# partir del propio texto pegado. Es lo que hace que `make up`, `make check`
# y `make e2e` funcionen sin clave de OpenAI y sin gastar nada. Las citas de
# la simulación salen del anuncio, así que la validación de citas se ejecuta
# de verdad y la pantalla se ve poblada.
#
# Para extraer en serio, en tu `.env` y no aquí: LLM_PROVIDER=openai con la
# clave y el modelo de abajo. Con ENV=production, `stub` no arranca.
LLM_PROVIDER=stub

# El repositorio privado `Futuro`, de donde salen el modelo de scoring y la
# guía de variantes de CV. Se monta de solo lectura en `/data/repo`.
#
# Por omisión apunta al repositorio **sintético** de los tests, que imita su
# forma y no comparte ni un dato con él: cuatro dimensiones inventadas,
# cuatro variantes inventadas y una persona que no existe. Con eso, un clon
# nuevo de este repositorio puntúa una oferta de punta a punta sin tener el
# privado delante.
#
# Para puntuar contra el de verdad, en tu `.env` y no aquí:
# DATA_REPO_HOST_PATH=/ruta/a/Futuro
DATA_REPO_HOST_PATH=./services/api/tests/fixtures/data_repo

# ---------------------------------------------------------------------------
# Producción. Con ENV=production la API no arranca si falta cualquiera de
# estos, en vez de fallar más tarde en la primera petición que lo necesite.
# ---------------------------------------------------------------------------
# ENV=production
# APP_DOMAIN=futuro.example.com
# PUBLIC_BASE_URL=https://futuro.example.com
# DEV_AUTH_BYPASS=false

# `openssl rand -hex 32`. Cambiarlo invalida todas las sesiones abiertas.
# SESSION_SECRET=

# Credenciales del cliente OAuth de Google. Redirect URI autorizado:
# https://<APP_DOMAIN>/api/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Allowlist de acceso, separada por comas. En la práctica, un solo email.
# ALLOWED_EMAILS=

# Clave de la API de OpenAI, de un proyecto propio con presupuesto mensual
# puesto. `OPENAI_MODEL` tiene que estar en la tabla de tarifas de
# `services/api/src/futuro_api/llm/cost.py`: un modelo sin precio conocido
# no arranca, en vez de registrar un coste que nadie sabe calcular.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra

# En producción el repositorio de datos no se monta desde el disco: lo deja
# ahí el clon de solo lectura con su deploy key, que es M3. Hasta entonces
# `/api/health` informa de que no está y lo único que no funciona es
# puntuar; el resto de la aplicación sirve igual.
